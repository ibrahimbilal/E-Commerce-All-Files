					img(class="avatar" width="56" src="./assets/images/products/image-4.png")
				.content
					p <b>Austin Wade</b> has requested a new order 
					span.date 15 min ago
			li.notify-item.d-flex.align-items-center
				.img.me-2
					img(class="avatar" width="56" src="./assets/images/avatars/image-03.png")
				.content
					p <b>Daniil Lobachev</b> has Published a new product
					span.date 25 min ago

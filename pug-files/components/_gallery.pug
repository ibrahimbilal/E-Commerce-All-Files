// Gallery Component
.gallery
    .overlay.p-3.p-sm-4
        .g-holder.main-box.box-spaces.d-flex.flex-column
            .d-flex.justify-content-between.align-items-center
                h3.m-0 Select Image
                span(id="close-overlay" class="icon" tooltip="Close" flow="left")
                    +getRIcon('cross')
            hr
            .d-flex.justify-content-between.align-items-sm-center.flex-column-reverse.flex-sm-row.mb-2
                    .bulk-action.align-self-end.mt-2.mt-sm-0.w-100
                        include ./../components/_bulk-action
                    .search-holder
                        form.search-form
                            .form-item.second.d-flex.align-items-center
                                label.item-title.meta-title.me-2(for="gal-search") Search:
                                input#gal-search.form-control.d-inline-block(type="text" name="s")
            
            .images.mt-3
                ul.list-unstyled.images-list
                    - for (var x = 0; x <= 7; ++x) {
                        - for (var i = 1; i <= 13; ++i) {
                            li.img-item 
                                label.d-flex.justify-content-center.align-items-center
                                    input(type="checkbox" name="img-"+ i + '-' + x)
                                    img(src="./assets/images/products/image-"+i+".png")
                        - }
                    - }

            .row.mt-2
                .col-6.offset-6.text-end
                    a.btn.solid-btn.select-btn(href="javascript:void(0)") Select
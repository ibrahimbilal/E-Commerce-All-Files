.swiper-container
	.swiper-wrapper
		.swiper-slide.main-box.box-spaces.d-flex.justify-content-between.align-items-center
			.icon-holder
				span.mauve
					+getRIcon("users")
			.detail-holder
				p.text-start.m-0 6998
				p.text-start.m-0 Customers

		.swiper-slide.main-box.box-spaces.d-flex.justify-content-between.align-items-center
			.icon-holder
				span.green
					+getRIcon("box")
			.detail-holder
				p.text-start.m-0 43.6K
				p.text-start.m-0 Orders

		.swiper-slide.main-box.box-spaces.d-flex.justify-content-between.align-items-center
			.icon-holder
				span.red
					+getRIcon("dollar")
			.detail-holder
				p.text-start.m-0 958.6K
				p.text-start.m-0 Sales

		.swiper-slide.main-box.box-spaces.d-flex.justify-content-between.align-items-center
			.icon-holder
				span.orange
					+getRIcon("paper-plane")
			.detail-holder
				p.text-start.m-0 60.7K
				p.text-start.m-0 Subscribers
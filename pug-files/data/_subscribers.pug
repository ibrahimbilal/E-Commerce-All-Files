table(id="subscribers" class="table table-striped")
	thead
		tr
			th
			th.text-uppercase name
			th.text-uppercase email
			th.text-uppercase country
			th.text-uppercase created date
			th.text-uppercase action
	tbody
		tr
			td
			td.text-capitalize Jayson Hinrichsen
			td.text-uppercase email@example.com
			td.text-capitalize United State
			td.text-uppercase 14:58 26/03/2021
			td
				.btn-group
					a.btn.btn-warning.btn-rounded.me-2.py-1
						span.icon
							+getRIcon("edit")
						| edit
					a.btn.btn-danger.btn-rounded.me-2.py-1
						span.icon
							+getRIcon("trash")
						| trash

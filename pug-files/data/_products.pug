				each row in rows
					tr
						td
						td.prod-img
							.img-holder
								img(src="./assets/images/products/image-"+ row.img +".png" width="70")
						td.prod-title= row.title
						td.text-uppercase= row.sku
						td= row.price
						td.text-capitalize= row.status
						td.text-center
							label.switch
								input(type="checkbox" class="switch" name="featured" data-product-id="1" checked)
								span.slider
						td.text-center
							label.switch
								input(type="checkbox" class="switch" name="new" data-product-id="1")
								span.slider
						td 14:58 26/03/2022
						td
							.btn-group
								a.btn.btn-primary.btn-rounded.me-2.py-1
									span.icon
										+getRIcon("eye")
									| view
								a.btn.btn-warning.btn-rounded.me-2.py-1
									span.icon
										+getRIcon("edit")
									| edit
								a.btn.btn-danger.btn-rounded.me-2.py-1
									span.icon
										+getRIcon("trash")
									| trash
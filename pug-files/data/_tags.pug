.table-responsive
	table(id="tags" class="table table-striped")
		thead
			tr
				th
				th.text-uppercase the title
				th.text-uppercase description
				th.text-uppercase slug
				th.text-uppercase count
				th.text-uppercase.text-center active
				th.text-uppercase action
		tbody

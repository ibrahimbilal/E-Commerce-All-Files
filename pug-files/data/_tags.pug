{title: "T-Shirts", desc: "t-shirt tag", slug: "w-t-shirts", count: "245"},{title: "Clothes", desc: "Clothes Tag", slug: "clothes", count: "245"},{title: "Men", desc: "Men Tag", slug: "men", count: "245"},{title: "T-Shirts", desc: "t-shirt tag", slug: "t-shirts", count: "245"},{title: "Women", desc: "Women Tag", slug: "women", count: "245"},{title: "T-Shirts", desc: "t-shirt tag", slug: "w-t-shirts", count: "245"},{title: "Clothes", desc: "Clothes Tag", slug: "clothes", count: "245"},{title: "Men", desc: "Men Tag", slug: "men", count: "245"},{title: "T-Shirts", desc: "t-shirt tag", slug: "t-shirts", count: "245"},{title: "Women", desc: "Women Tag", slug: "women", count: "245"},{title: "T-Shirts", desc: "t-shirt tag", slug: "w-t-shirts", count: "245"}]
				each row in rows
					tr
						td
						td.prod-title= row.title
						td.text-capitalize= row.desc
						td= row.slug
						td.text-center= row.count
						td.text-center
							label.switch
								input(type="checkbox" class="switch" name="active" data-product-id="1" checked)
								span.slider
						td
							.btn-group
								a.btn.btn-primary.btn-rounded.me-2.py-1
									span.icon
										+getRIcon("eye")
									| view
								a.btn.btn-warning.btn-rounded.me-2.py-1
									span.icon
										+getRIcon("edit")
									| edit
								a.btn.btn-danger.btn-rounded.me-2.py-1
									span.icon
										+getRIcon("trash")
									| trash
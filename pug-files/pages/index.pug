extends ../bases/_main_layout
block mainContent
	.slider-holder
		include ./../components/_swiper-slider

	.row
		.col-12.col-xxl-8
			.main-box.box-spaces
				#chart

		.col-12.col-sm-6.col-xxl-4
			.main-box.box-spaces
				h2.box-title.text-capitalize Top Selling Products
				.list-holder
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/products/image-1.png" alt="product 1")
						.title.text-start.w-100.ps-4 Apple Watch Series 4 GPS
						.price $399
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/products/image-2.png" alt="product 2")
						.title.text-start.w-100.ps-4 Beats Headphones
						.price $459
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/products/image-3.png" alt="product 2")
						.title.text-start.w-100.ps-4 Apple iPad Pro 64GB
						.price $899

		.col-12.col-sm-6.col-xxl-4
			.main-box.box-spaces
				.box-header.d-flex.align-items-center.justify-content-between.flex-row-reverse
					.select-holder
						select.select
							option(value="7") Last 7 Days
							option(value="14") Last 14 Days
							option(value="30") Last 30 Days
					h2.box-title.text-capitalize Visitors Referrals
				.list-holder
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/social/facebook.png" alt="facebook")
						.title.text-start.w-100.ps-4 Facebook - 52%
						.percent.good 20%
							+getSIcon("arrow-small-up")
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/social/google.png" alt="google")
						.title.text-start.w-100.ps-4 Google - 34.6%
						.percent.good 14%
							+getSIcon("arrow-small-up")
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/social/instagram.png" alt="instagram")
						.title.text-start.w-100.ps-4 Instagram - 9.7%
						.percent.good 33%
							+getSIcon("arrow-small-up")
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/social/snapchat.png" alt="snapchat")
						.title.text-start.w-100.ps-4 Snapchat - 2.58%
						.percent.good 6%
							+getSIcon("arrow-small-up")
					.list-item.d-flex.align-items-center.justify-content-between
						.img
							img(src="./assets/images/social/random.png" alt="Others")
						.title.text-start.w-100.ps-4 Others - 1.12%
						.percent.bad -50%
							+getSIcon("arrow-small-down")

		.col-12.col-xxl-8
			.main-box.box-spaces.mb-0
				h2.box-title.text-capitalize Orders Statuses 
				.table-holder
					include ./../data/_tables

block footer_script
	script.
		// Data Tables.
		$('#example').DataTable({
			dom: 'Bfrtip',
			language: {
				info: "Show _START_ To _END_ Of _TOTAL_ Orders",
				buttons: {
					pageLength: 'Show %d',
					colvis: 'Columns'
				}
			},
			stateSave: true,
			paging: true,
			searching: true,
			lengthMenu: [[ 5, 10, 15, 20 ], ['5 Orders', '10 Orders', '15 Orders', '20 Orders']],
			buttons: ($(window).width() > 578) ? ['pageLength', 'print', {
				extend: 'collection',
				text: 'Export',
				className: 'btn btn-group',
				buttons: [
					{
						extend: 'excelHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'csvHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'pdfHtml5',
						className: 'dropdown-item'
					}
				]
			}, 'colvis'] : ['pageLength', {
				extend: 'collection',
				text: 'Export',
				className: 'btn btn-group',
				buttons: [
					{
						extend: 'excelHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'csvHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'pdfHtml5',
						className: 'dropdown-item'
					}
				]
			}, 'colvis']
		});
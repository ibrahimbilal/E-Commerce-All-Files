							.item-title subtotal:
							span.ms-2 799$
						.item.form-item.second.d-flex.justify-content-between
							.item-title tax:
							span.ms-2 100$
						.item.form-item.second.d-flex.justify-content-between
							.item-title Shipping Costs:
							span.ms-2 159.8$
						.item.form-item.second.d-flex.justify-content-between
							.item-title Order Total Costs:
							span.ms-2 1058.8$


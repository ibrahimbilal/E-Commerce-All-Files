extends ../bases/_main_layout
block mainContent
	.page-header
		.row
			.col-12.d-flex.align-items-sm-center.justify-content-sm-between.flex-column.flex-sm-row
				// Page Title
				- var pageTitle = 'add attribute'
				- var btnType = ''
				include ./../components/_page-title

				// Breadcrubs
				- var breadCrumbsItems = ['attributes', 'add']
				include ./../components/_breadcrumbs

	form#add-newitem-form.row.clearfix(data-post-type="attribute")
		.col-sm-12
			.main-box.box-spaces
				.form-item.primary
					h2.box-title.item-title attribute title
					input#item-title.form-control(name="attribute_name" type="text")

		.col-sm-12.col-lg-9.post-box
			.main-box.box-spaces
				.form-item.primary
					h2.box-title.item-title Attribute Terms
				.alerts.warning
					p.content You Haven't Create Any Terms Yet.

				.repeater-holder
					.repeater.mb-3
						.repeater-title.p-3.mb-3.d-flex.justify-content-between.align-items-center
							h3.h5.mb-0 Term Title
							.icons.d-flex.align-items-center
								span.icon.active
									+getRIcon("angle-small-down")
								span.remove(tooltip="Remove" flow="up")
									+getRIcon("trash")

						.repeater-inputs.px-3.active
							.form-item.second.d-flex.align-items-center.flex-wrap.flex-sm-nowrap
								label.item-title(for="term-title") term title:
								input#term-title.form-control(name="term_title" type="text")

							.form-item.second.d-flex.align-items-center.flex-wrap.flex-sm-nowrap.mt-3
								label.item-title(for="term-type") term type:
								select#term-type.form-select(name="term_type")
									option Text
									option Color

							.form-item.second.d-flex.align-items-center.flex-wrap.flex-sm-nowrap.mt-3
								label.item-title(for="term-value") term value:
								input#term-value.form-control(name="term_value" type="text")

				.add-repeater-item.mt-3
					a.btn Add New Attribute Term

		.col-sm-12.col-lg-3.meta-box
			.row.d-block.clearfix
				.col-sm-6.col-lg-12.float-end.float-lg-none
					.main-box.box-spaces.mb-0
						.form-item.second
							label.item-title.meta-title(for="item-slug") attribute slug:
								span(class="icon info ms-2" tooltip="slug is the bit of text that appears after your domain name in the URL of a page" flow="up")
									+getRIcon("info")
							input#item-slug.form-control.mt-2(name="attribute_slug" type="text")

						.form-item.second.justify-content-between.mt-2.d-flex.align-items-sm-center
							label.item-title.meta-title created at: 
							span.ms-2 26/03/2021 14:58

						.form-item.second.justify-content-between.mt-2.d-flex.align-items-sm-center
							label.item-title.meta-title updated at:
							span.ms-2 26/03/2021 14:58

						.btns-holder.d-flex.justify-content-between.mt-4
							button.btn.regular-btn.draft(data-post-type="tag") save as draft
							button.btn.solid-btn(type="submit") publish 

						.btns-holder.d-flex.justify-content-between.mt-2
							button.btn.trans-btn.w-100.text-start.delete(data-post-type="tag")
								span.icon.me-1
									+getRIcon("trash")
								| move to trash

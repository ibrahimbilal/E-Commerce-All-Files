extends ../bases/_main_layout
block mainContent
	.page-header
		.row
			.col-12.d-flex.align-items-sm-center.justify-content-sm-between.flex-column.flex-sm-row
				// Page Title
				- var pageTitle = 'gallery'
				- var btnType = ''
				include ./../components/_page-title

				// Breadcrumbs
				- var breadCrumbsItems = ['gallery']
				include ./../components/_breadcrumbs

	.gallery-page
		.upload-holder.mb-3
			form#upload-form(action="./upload" method="post"  enctype="multipart/form-data")

		.page-content.row
			.col-sm-12.col-lg-9.float-start.post-box.order-1.open
				.g-holder.main-box.box-spaces.d-flex.flex-column.mb-0
					.d-flex.justify-content-between.align-items-sm-center.flex-column-reverse.flex-sm-row.mb-2
						.bulk-action.align-self-end.mt-2.mt-sm-0.w-100
							include ./../components/_bulk-action
						.search-holder
							form.search-form
								.form-item.second.d-flex.align-items-center
									label.item-title.meta-title.me-2(for="gal-search") Search:
									input#gal-search.form-control.d-inline-block(type="text" name="s")

					.images.mt-3
						ul.list-unstyled.images-list
							- for (var x = 0; x <= 2; ++x) {
								- for (var i = 1; i <= 35; ++i) {
									li.img-item 
										label.d-flex.justify-content-center.align-items-center
											input(type="checkbox" name="img-"+ i + '-' + x)
											img(src="./assets/images/gallery/image-"+i+".jpg")
								- }
							- }

			.col-sm-12.col-lg-3.float-end.meta-box.order-lg-1.hide
				.main-box.box-spaces
					.row
						.col-sm-5.col-lg-12.d-flex.justify-content-center.align-items-center
							.img-view.text-center
								img(src="./assets/images/products/image-v.png")

						.col-sm-7.col-lg-12
							form#edit-image-gallery
								table.mt-2.w-100
									tbody
										tr
											td.py-2
												.form-item.second
													label.item-title.meta-title File Name:
											td.py-2
												.form-item.second
													span.ps-2 product-12.jpg

										tr
											td.py-2
												.form-item.second
													label.item-title.meta-title updated date:
											td.py-2
												.form-item.second
													span.ps-2 26/03/2021 14:58

										tr
											td.py-2
												.form-item.second
													label.item-title.meta-title uploaded by:
											td.py-2
												.form-item.second
													span.ps-2 Jayson Hinrichsen
										tr
											td.py-2
												.form-item.second
													label.item-title.meta-title Image Url:
											td.py-2
												.form-item.second
													input.form-control.ps-2(value="https://website.com/public/..." disabled readonly)
										tr
											td.py-2
												.form-item.second
													label.item-title.meta-title Image Title:
											td.py-2
												.form-item.second
													input.form-control.ps-2(value="product 12")
										tr
											td.py-2
												.form-item.second
													label.item-title.meta-title Alt Text:
											td.py-2
												.form-item.second
													input.form-control.ps-2

								.btns-holder.d-flex.justify-content-between.mt-4
									button.btn.trans-btn.text-start.delete(data-post-type="Product")
										span.icon.me-1
											+getRIcon("trash")
										| move to trash
									button.btn.solid-btn(type="submit") save 
block footer_script
	script.
		$.fn.filepond.registerPlugin(
			FilePondPluginImagePreview,
			FilePondPluginFileValidateSize,
			FilePondPluginFileValidateType
		);

		var mockServer = {
			remove: null,
			revert: null,
			process: function(fieldName, file, metadata, load, error, progress, abort, transfer, options) {

				var prog = 0;
				var total = file.size;
				var speed = 256 * 1024; // KB/s

				const tick = function() {

					prog += Math.random() * speed;
					prog = Math.min(total, prog);

					progress(true, prog, total);

					if (prog === total) {
						load(Date.now());
						return;
					}

					setTimeout(tick, Math.random() * 250)
				}

				tick();

				return {
					abort: function() {
						abort()
					}
				}
			}
		};

		$('#upload-form').filepond({
			allowFileSizeValidation: true,
			allowFileTypeValidation: true,
			allowMultiple: true,
			allowReorder: true,
			maxFileSize: '2MB',
			acceptedFileTypes: ['image/png', 'image/jpg', 'image/jpeg'],
			labelFileTypeNotAllowed: 'File is invalid type',
			fileValidateTypeLabelExpectedTypes: '{allButLastType}',
			server: mockServer,
		});
		$('#upload-form').on('FilePond:init', function(e) {
			console.log('file added event', e);
		});
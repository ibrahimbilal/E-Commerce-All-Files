extends ../bases/_base
block mainContent
	- var flexClasses = ['d-flex', 'align-items-sm-center']
	.page-header
		.row
			.col-12(class=flexClasses).justify-content-sm-between.flex-column.flex-sm-row
				- var pageTitle = 'settings'
				- var btnType = ''
				include ./../components/_page-title

				.page-breadcrumbs(class=flexClasses).justify-content-start.justify-content-sm-end
					- var breadCrumbsItems = ['settings']
					include ./../components/_breadcrumbs

	form#settings-form.row.d-block.clearfix(data-post-type="settings")
		.col-sm-12.col-lg-9.float-start.post-box
			.main-box.box-spaces
				.form-item.primary.mb-3
					h2.box-title.item-title Emails Settings

				.form-item.second.d-flex.align-items-center.flex-wrap.flex-sm-nowrap
					label.item-title(for="email-from") "From" Name:
						span(class="icon info ms-2" tooltip="How the sender name appears in outgoing your store emails." flow="up")
							+getRIcon("info")
					input#email-from.form-control(name="email_from" type="text" placeholder="Store Name")

				.form-item.second.d-flex.align-items-center.flex-wrap.flex-sm-nowrap.mt-3
					label.item-title(for="email-from") "From" Address:
						span(class="icon info ms-2" tooltip="How the sender email appears in outgoing from your store emails." flow="up")
							+getRIcon("info")
					input#email-from.form-control(name="email_from" type="text" placeholder="example@email.com")
				
				.form-item.second.d-flex.flex-wrap.align-items-center.mt-3
					label.item-title.mb-2 Base Color:
						span(class="icon info ms-2" tooltip="The base color for store email templates. Default #2C2CCC." flow="up")
							+getRIcon("info")
					input.form-control-color(type="color" name="email_base_color" value="#2C2CCC" title="Choose your color")
				
				.form-item.second.d-flex.flex-wrap.align-items-center.mt-3
					label.item-title.mb-2 Background Color:
						span(class="icon info ms-2" tooltip="The background color for store email templates. Default #F7F7F7." flow="up")
							+getRIcon("info")
					input.form-control-color(type="color" name="email_bg_color" value="#F7F7F7" title="Choose your color")
				
				.form-item.second.d-flex.flex-wrap.align-items-center.mt-3
					label.item-title.mb-2 Body Background Color:
						span(class="icon info ms-2" tooltip="The main body background color. Default #FFFFFF." flow="up")
							+getRIcon("info")
					input.form-control-color(type="color" name="email_body_bg_color" value="#FFFFFF" title="Choose your color")
				
				.form-item.second.d-flex.flex-wrap.align-items-center.mt-3
					label.item-title.mb-2 Body Text Color:
						span(class="icon info ms-2" tooltip="The main body text color. Default #333333." flow="up")
							+getRIcon("info")
					input.form-control-color(type="color" name="email_text_color" value="#333333" title="Choose your color")

				hr

				.form-item.primary.mb-3
					h2.box-title.item-title Email Notification Settings

				- var sections = [{title: "New Order Placed", id: "new-order", tooltip: "Sent email when a new order is placed"}, {title: "Out Of Stock", id: "out-of-stock", tooltip: "Sent email when product is out of stock"}, {title: "Order Canceled", id: "order-canceled", tooltip: "Sent email when customer canceled the order"}]
				each section in sections
					.form-item.second.d-flex.mt-3.flex-wrap
						.item-title.d-block.mb-2
							label.item-title(for=`${section.id}`)= `${section.title}:`
								span(class="icon info ms-2" tooltip=`${section.tooltip}` flow="up")
									+getRIcon("info")
							small Recipient Are Store Users
						.item-content
							label.switch.text-start
								input(id=`${section.id}` type="checkbox" class="switch control-toggle" data-toggle=`${section.id}-recipients` name="email-new-order" checked)
								span.slider

							.form-item.d-flex.flex-column.mt-1(id=`${section.id}-recipients`)
								.item-title send to:
									span(class="icon info ms-2" tooltip="Custom Recipients: you should choose recipients from the list. Recipients By Role: all members in the role will be receive the email." flow="up")
										+getRIcon("info")
								.controls-wrapper.d-flex.align-items-start.mt-2
									select.form-select.w-mc.me-2(name=`${section.id}-recipients-type`)
										option(value="custom") Custom Recipients
										option(value="recipients-role") Recipients By Role

									.select2-wrapper.w-100
										select.form-select.multi-select(id=`${section.id}-recipients-emails` name=`${section.id}-recipients-emails` multiple="multiple" placeholder="Select Recipients")
											- var emails = ["example1@email.com", "example2@email.com", "example3@email.com", "example4@email.com", "example5@email.com", "example6@email.com"]
											each email in emails
												option(value=email)= email

				- var sections = [{title: "Order Confirmed", id: "order-confirmed", tooltip: "Sent email automatically after purchase"}, {title: "Order Shipped", id: "order-shipped", tooltip: "Sent email automatically when an order is marked as shipped"}, {title: "Order Completed", id: "order-completed", tooltip: "Sent automatically when an order is marked as completed"}, {title: "Order Refunded", id: "order-refunded", tooltip: "Sent automatically when a refund is issued"}]
				each section in sections
					.form-item.second.d-flex.mt-3
						.item-title.d-block.mb-2
							label.item-title(for=`${section.id}`)= `${section.title}:`
								span(class="icon info ms-2" tooltip=`${section.tooltip}` flow="up")
									+getRIcon("info")
							small Recipient Is Customer
						.item-content
							label.switch.text-start
								input(id=`${section.id}` type="checkbox" class="switch" name=`${section.id}` checked)
								span.slider

		.col-sm-6.col-lg-3.float-end.meta-box
			.main-box.box-spaces.mb-0.mt-3.mt-lg-0
				.btns-holder.d-flex.justify-content-between
					button.btn.solid-btn.w-100(type="submit") Save Changes 
block footer_script
	include ./../components/_gallery
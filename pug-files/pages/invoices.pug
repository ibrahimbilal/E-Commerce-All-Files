extends ../bases/_base
block mainContent
	- var flexClasses = ['d-flex', 'align-items-sm-center']
	.page-header
		.row
			.col-12(class=flexClasses).justify-content-sm-between.flex-column.flex-sm-row
				.page-title.text-capitalize invoices

				.page-breadcrumbs(class=flexClasses).justify-content-start.justify-content-sm-end
					- var breadCrumbsItems = ['invoices']
					include ./../components/_breadcrumbs

	.row
		.col-12(class=flexClasses).justify-content-between.flex-column.flex-sm-row.mb-2
			.dash-filters
				- var filters = ['All (50)', 'Trashed (99)']
				each val, index in filters
					a.item.text-capitalize(href="#")= val

			.bulk-action.align-self-end
				include ./../components/_bulk-action

		.col-12
			.main-box.box-spaces.mb-0
				.table-holder.mt-0
					.table-responsive
						table(id="invoices" class="table table-striped")
							thead
								tr
									th
									th.text-uppercase invoice no
									th.text-uppercase customer
									th.text-uppercase total Cost
									th.text-uppercase created date
									th.text-uppercase action
							tbody
								tr
									td
									td #123
									td.prod-title Jayson Hinrichsen

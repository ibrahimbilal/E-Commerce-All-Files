extends ../bases/_main_layout
block mainContent
	.page-header
		.row
			.col-12.d-flex.align-items-sm-center.justify-content-sm-between.flex-column.flex-sm-row
				// Page Title
				- var pageTitle = 'customer'
				- var btnType = 'edit'
				include ./../components/_page-title

				// Breadcrumbs
				- var breadCrumbsItems = ['customers', 'view']
				include ./../components/_breadcrumbs

	.row
		.col-12
			.main-box.box-spaces
				.row
					.col-sm-12.col-lg-3.d-flex.justify-content-center.user-holder
						.profile-image.text-center
							img(src="./assets/images/customers/image-1.png")
					.col-sm-12.col-lg-9
						.profile-details.row.mt-3.mt-lg-0
							- var profileDetailsRows = [[{title: 'First Name:', value: 'Mildred'},{title: 'Last Name:', value: 'Stoddard'},{title: 'Email Address:', value: 'm.stoddard@gmail.com'},{title: 'Registered At:', value: '26/03/2021 14:58'},{title: 'Updated At:', value: '26/03/2021 14:58'},{title: 'Last Logged In:', value: '26/03/2021 14:58'},{title: 'Device:', value: 'Samsung Galaxy S20'}],[{title: 'Birth Of Date:', value: '26/03/2021'},{title: 'Mobile:', value: '516-913-8323'},{title: 'Gender:', value: 'Female'},{title: 'iP Address:', value: '216.58.217.164'},{title: 'iP Country:', value: 'United State'},{title: 'iP City:', value: 'New York'}]]
							each row in profileDetailsRows
								.col-sm-6
									each detail in row
										.form-item.second.justify-content-between.mt-2.d-flex.align-items-sm-center
											.title
												b= detail.title
											span.ms-2= detail.value

		.col-12.col-lg-5
			.main-box.box-spaces
				h2.box-title.text-capitalize.mb-3 Addresses 
				.repeater-holder
					.repeater
						.repeater-title.p-3.d-flex.justify-content-between.align-items-center
							h3.h6.mb-0 First Address Title
							.icons.d-flex.align-items-center
								span.icon.active
									+getRIcon("angle-small-down")
						.repeater-inputs.active
							table.table.mb-0
								tbody
									tr
										td.text-capitalize Country:
										td.text-capitalize United State
									tr
										td.text-capitalize State:
										td.text-capitalize New York
									tr
										td.text-capitalize City:
										td.text-capitalize New York City
									tr
										td.text-capitalize Address 1:
										td.text-capitalize 1881  Rosewood Lane
									tr
										td.text-capitalize Address 2:
										td.text-capitalize
									tr
										td.text-capitalize Postal Code:
										td.text-capitalize 10011
									tr
										td.text-capitalize Mobile:
										td.text-capitalize 212-915-2541

		.col-12.col-lg-7
			.main-box.box-spaces.mb-0
				h2.box-title.text-capitalize.mb-3 Orders 
				.table-holder
					include ./../data/_c_orders

block footer_script
	script.
		// Data Tables.
		$('#example').DataTable({
			dom: 'Bfrtip',
			language: {
				info: "Show _START_ To _END_ Of _TOTAL_ Orders",
				buttons: {
					pageLength: 'Show %d',
					colvis: 'Columns'
				}
			},
			stateSave: true,
			paging: true,
			searching: true,
			lengthMenu: [[ 5, 10, 15, 20 ], ['5 Orders', '10 Orders', '15 Orders', '20 Orders']],
			buttons: ($(window).width() > 578) ? ['pageLength', 'print', {
				extend: 'collection',
				text: 'Export',
				className: 'btn btn-group',
				buttons: [
					{
						extend: 'excelHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'csvHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'pdfHtml5',
						className: 'dropdown-item'
					}
				]
			}, 'colvis'] : ['pageLength', {
				extend: 'collection',
				text: 'Export',
				className: 'btn btn-group',
				buttons: [
					{
						extend: 'excelHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'csvHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'pdfHtml5',
						className: 'dropdown-item'
					}
				]
			}, 'colvis']
		});
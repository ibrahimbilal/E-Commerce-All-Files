extends ../bases/_base
block mainContent
	- var flexClasses = ['d-flex', 'align-items-sm-center']
	.page-header
		.row
			.col-12(class=flexClasses).justify-content-sm-between.flex-column.flex-sm-row
				.page-title.text-capitalize orders
					a.add-btn.btn.text-capitalize(href='./add-order.html')
						span.icon
							+getRIcon("add")
						| add new

				.page-breadcrumbs(class=flexClasses).justify-content-start.justify-content-sm-end
					- var breadCrumbsItems = ['orders']
					include ./../components/_breadcrumbs

	.row
		.col-12(class=flexClasses).justify-content-between.flex-column.flex-sm-row.mb-2
			.dash-filters
				- var filters = ['All (50)', 'Trashed (99)', 'Processing (45)', 'Completed (99)', 'On Hold (99)', 'Canceled (99)', 'Refunded (99)']
				each val, index in filters
					a.item.text-capitalize(href="#")= val

			.bulk-action.align-self-end
				include ./../components/_bulk-action

		.col-12
			.main-box.box-spaces.mb-0
				.table-holder.mt-0
					include ./../data/_main-orders

block footer_script
	script.
		// Data Tables
		let product_table = $('#orders').DataTable({
			dom: 'Bfrtip',
			columnDefs: [
				{
					orderable: false,
					className: 'select-checkbox',
					targets: 0
				},
				{ 
					bSortable: false, 
					aTargets: [ 0, 7] 
				},
				{ 
					bSearchable: false, 
					aTargets: [ 0, 7] 
				}
			],
			select: {
				style: 'os',
				selector: 'td:first-child'
			},
			order: [
				[1, 'desc']
			],
			language: {
				info: "Show _START_ To _END_ Of _TOTAL_ Orders",
				buttons: {
					pageLength: 'Show %d',
					colvis: 'Columns'
				}
			},
			stateSave: true,
			paging: true,
			searching: true,
			lengthMenu: [[ 10, 15, 25, 50, 75, 100 ], ['10 Orders', '15 Orders', '25 Orders', '50 Orders', '75 Orders', '100 Orders']],
			buttons: ($(window).width() > 578) ? ['pageLength', 'print', {
				extend: 'collection',
				text: 'Export',
				className: 'btn btn-group',
				buttons: [
					{
						extend: 'excelHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'csvHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'pdfHtml5',
						className: 'dropdown-item'
					}
				]
			}, 'colvis'] : ['pageLength', {
				extend: 'collection',
				text: 'Export',
				className: 'btn btn-group',
				buttons: [
					{
						extend: 'excelHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'csvHtml5',
						className: 'dropdown-item'
					},
					{
						extend: 'pdfHtml5',
						className: 'dropdown-item'
					}
				]
			}, 'colvis']
		});
		product_table.on("click", "th.select-checkbox", function() {
			if ($("th.select-checkbox").hasClass("selected")) {
				product_table.rows().deselect();
				$("th.select-checkbox").removeClass("selected");
			} else {
				product_table.rows().select();
				$("th.select-checkbox").addClass("selected");
			}
		}).on("select deselect", function() {
			("Some selection or deselection going on")
			if (product_table.rows({
					selected: true
				}).count() !== product_table.rows().count()) {
				$("th.select-checkbox").removeClass("selected");
			} else {
				$("th.select-checkbox").addClass("selected");
			}
		});
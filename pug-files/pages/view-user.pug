extends ../bases/_base
block mainContent
	- var flexClasses = ['d-flex', 'align-items-sm-center']
	.page-header
		.row
			.col-12(class=flexClasses).justify-content-sm-between.flex-column.flex-sm-row
				.page-title.text-capitalize view user
					a.add-btn.btn.text-capitalize(href='./add-user.html')
						span.icon
							+getRIcon("edit")
						| edit <span class="page">user<span>

				.page-breadcrumbs(class=flexClasses).justify-content-start.justify-content-sm-end
					- var breadCrumbsItems = ['users', 'view']
					include ./../components/_breadcrumbs

	.row
		.col-12
			.main-box.box-spaces
				.row
					.col-sm-12.col-lg-3.d-flex.justify-content-center.user-holder
						.profile-image.text-center.w-100
							img(src="./assets/images/customers/image-1.png")
					.col-sm-12.col-lg-9
						.profile-details.row
							.col-sm-6
								.form-item.second.justify-content-between.mt-2(class=flexClasses)
